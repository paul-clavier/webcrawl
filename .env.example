# Contact email sent in the User-Agent header to Common Crawl (please set your own).
CONTACT_EMAIL=you@example.com

# Elasticsearch (matches docker-compose.yml)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=eurosport_pages

# Postgres + pgvector (matches docker-compose.yml)
POSTGRES_DSN=postgresql://eurosport:eurosport@localhost:5432/eurosport

# Embedding model. Changing it requires `4_store.py --recreate`.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
